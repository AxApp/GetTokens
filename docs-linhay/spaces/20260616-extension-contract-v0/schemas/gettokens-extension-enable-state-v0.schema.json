{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gettokens.local/schemas/gettokens-extension-enable-state-v0.schema.json",
  "title": "GetTokens Extension Enable State Artifact v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactVersion",
    "readOnlySlice",
    "enableStates",
    "actionAvailability",
    "cases"
  ],
  "properties": {
    "artifactVersion": {
      "const": "gettokens.extension.enable-state.v0"
    },
    "readOnlySlice": {
      "const": true
    },
    "enableStates": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/enableState"
      }
    },
    "actionAvailability": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/actionAvailability"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/enableStateCase"
      }
    }
  },
  "$defs": {
    "enableState": {
      "enum": [
        "enabled",
        "disabled",
        "blocked",
        "pending",
        "readonly-unsupported"
      ]
    },
    "actionAvailability": {
      "enum": [
        "read-only",
        "disabled"
      ]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "enableStateCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "registryState",
        "compatibilityStatus",
        "enableState",
        "actionAvailability",
        "reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "registryState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "compatibilityStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "diagnosticCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "uniqueItems": true
        },
        "enableState": {
          "$ref": "#/$defs/enableState"
        },
        "actionAvailability": {
          "$ref": "#/$defs/actionAvailability"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    }
  }
}
